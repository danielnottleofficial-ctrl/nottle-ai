# Application
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
APP_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data
ALLOW_SIGNUPS=true
TRIAL_DAYS=14
SESSION_DAYS=30
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost

# OpenAI Realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_VOICE=marin

# Twilio
TWILIO_AUTH_TOKEN=
VERIFY_TWILIO_SIGNATURE=false

# Default business / owner account
DEFAULT_BUSINESS_NAME=DN Property Projects
DEFAULT_BUSINESS_PHONE=08 7666 3281
DEFAULT_BUSINESS_AREA=Perth, Western Australia
SUPPORT_EMAIL=DNPropertyProjects@outlook.com
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password-reset email (required by the production health check; STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Owner SMS approval (default business only; keep disabled until end-to-end tested)
BOOKING_APPROVAL_ENABLED=false
BOOKING_EXTRACT_MODEL=gpt-4.1-mini
TWILIO_ACCOUNT_SID=
TWILIO_MESSAGING_FROM=
SMS_SUMMARY_RECIPIENT=
# Use a Twilio number capable of both sending AND receiving SMS.
# Incoming messaging webhook: POST /sms/incoming
# Google OAuth credential values stay in Render secrets, never in Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# App workflow: push + manual SIM SMS; disables automatic booking SMS jobs.
APP_APPROVAL_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_JSON=

# Dedicated business calendar shared with existing Firebase service account.
GOOGLE_USE_SERVICE_ACCOUNT=false
